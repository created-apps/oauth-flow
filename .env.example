# Server
PORT=3000
NODE_ENV=development
# Comma-separated allowed browser origins for CORS (no localhost when NODE_ENV=production)
FRONTEND_ORIGIN=http://localhost:3000
# Optional — if BOTH set, /auth/:provider/callback redirects to the frontend instead of
# returning JSON. Must be URLs whose origin is in FRONTEND_ORIGIN. Leave blank for API-only mode.
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/
OAUTH_ERROR_REDIRECT=http://localhost:3000/

# Database (Supabase — use session pooler connection string, service role)
DATABASE_URL=

# Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# Auth
JWT_SECRET=

# Token rotation buffer — how long to keep prev_refresh_token before clearing (TBD)
PREV_TOKEN_BUFFER_SECONDS=

# Google OAuth — http://localhost is accepted by Google for dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Slack — workspace bot token (xoxb-...), NOT OAuth. Copy from the Slack app's
# OAuth & Permissions page after installing to the workspace. Optional until a Slack
# automation is built. The bot must be /invite'd to each channel it reads or posts in.
SLACK_BOT_TOKEN=
